# Supabase 프로젝트 설정 → API 에서 복사합니다. 두 값 모두 브라우저에 공개돼도 되는 값입니다.
# (데이터 보호는 RLS 가 담당합니다. service_role / sb_secret 키는 이 앱에 넣지 않습니다.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# (선택) /api/keepalive 를 외부에서 함부로 호출하지 못하게 하는 값. Vercel Cron 이 자동으로 보냅니다.
CRON_SECRET=
